@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title ELVIS elvenett - Filnedlastning - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class Sideelv <<featureType>> {
    + linje [1] : Kurve
  }

  class HovedelvIgrensefelt <<featureType>> {
    + linje [1] : Kurve
  }

  abstract class RegToppRuteP <<featureType>> {
    + høyde [1] : Real
    + identifikasjon [1] : Identifikasjon
    + nedbørfeltVassdragsNr [1] : CharacterString
    + objekttype [1] : CharacterString
    + vassdragsområde [1] : CharacterString
  }

  abstract class ElvenettL <<featureType>> {
    + andelQNormal6190 [0..1] : Integer
    + andelQNormalKlassifisert [0..1] : Integer
    + datafangstdato [0..1] : Date
    + elvelengde [1] : Real
    + elvenavn [0..1] : CharacterString
    + elveNavnHierarki [1] : CharacterString
    + elveordenStrahler [1] : Integer
    + elvID [1] : CharacterString
    + grenseelv [0..1] : Integer
    + identifikasjon [1] : Identifikasjon
    + land1 [1] : Land_NVE
    + land2 [0..1] : Land_NVE
    + nedbørfeltVassdragsNr [0..1] : CharacterString
    + objekttype [1] : CharacterString
    + oppdateringsdato [0..1] : Date
    + regineEnhetAreal [1] : Real
    + regulert [0..1] : Integer
    + skaarsversjon [1] : Integer
    + strekningLnr [0..1] : CharacterString
    + vassdragsNr [1] : CharacterString
    + vassdragsområde [1] : CharacterString
    + vatnLnr [1] : Integer
  }

  class "InnsjøMidtlinje" as Innsj_Midtlinje <<featureType>> {
    + linje [1] : Kurve
  }

  class "Elveutløp" as Elveutl_p <<featureType>> {
    + posisjon [1] : Punkt
  }

  class RegineSideelv <<featureType>> {
    + linje [1] : Kurve
  }

  class HovedelvIvassdragsOmr <<featureType>> {
    + linje [1] : Kurve
  }

  class Hovedelv <<featureType>> {
    + linje [1] : Kurve
  }

  class ElvetoppPunkt <<featureType>> {
    + posisjon [1] : Punkt
  }

  class ElvBekk <<featureType>> {
    + linje [1] : Kurve
  }

  class HovedelvIkystfelt <<featureType>> {
    + linje [1] : Kurve
  }

  class ElvelinjeFiktiv <<featureType>> {
    + linje [1] : Kurve
  }

  class Vassdragsnivellement <<featureType>> {
    + elvenavn [1] : CharacterString
    + identifikasjon [1] : Identifikasjon
    + linje [1] : Kurve
    + objekttype [1] : CharacterString
    + plansje [1] : Integer
    + plansjeLnr [1] : CharacterString
    + publisertÅr [1] : Integer
    + vannstandDato [1] : Integer
    + vassdragsområde [1] : CharacterString
  }

  abstract class ElvenettR <<featureType>> {
    + elvelengde [1] : Real
    + elvenavn [0..1] : CharacterString
    + elvID [1] : CharacterString
    + identifikasjon [1] : Identifikasjon
    + nedbørfeltArealKm2 [0..1] : Real
    + nedbørfeltVassdragsNr [1] : CharacterString
    + objekttype [1] : CharacterString
    + vassdragsområde [1] : CharacterString
  }

  class RegineElvetoppPunkt <<featureType>> {
    + posisjon [1] : Punkt
  }

  abstract class ToppRuteP <<featureType>> {
    + elvID [1] : CharacterString
    + høyde [1] : Real
    + identifikasjon [1] : Identifikasjon
    + nedbørfeltVassdragsNr [0..1] : CharacterString
    + objekttype [1] : CharacterString
    + vassdragsområde [1] : CharacterString
  }

  abstract class ElvUtlopP <<featureType>> {
    + elvID [1] : CharacterString
    + identifikasjon [1] : Identifikasjon
    + nedbørfeltArealKm2 [0..1] : Real
    + nedbørfeltVassdragsNr [0..1] : CharacterString
    + objekttype [1] : CharacterString
    + qNormal6190m3s [0..1] : Real
    + utløpid [1] : Integer
    + vassdragsområde [1] : CharacterString
  }

  class "InnsjøMidtlinjeReg" as Innsj_MidtlinjeReg <<featureType>> {
    + linje [1] : Kurve
  }

  class ElvBekkRegulert <<featureType>> {
    + linje [1] : Kurve
  }

  abstract class RegElvenettR <<featureType>> {
    + elvelengde [1] : Real
    + elvenavn [0..1] : CharacterString
    + identifikasjon [1] : Identifikasjon
    + nedbørfeltareal [1] : Real
    + nedbørfeltVassdragsNr [1] : CharacterString
    + nivå [1] : CharacterString
    + objekttype [1] : CharacterString
    + vassdragsområde [1] : CharacterString
  }

  class ElvBekkMidtlinje <<featureType>> {
    + linje [1] : Kurve
  }

  class Identifikasjon <<dataType>> {
    + lokalId [1] : CharacterString
    + navnerom [1] : CharacterString
  }
}

  ElvenettR <|-- Sideelv
  RegElvenettR <|-- HovedelvIgrensefelt
  ElvenettL <|-- Innsj_Midtlinje
  ElvUtlopP <|-- Elveutl_p
  RegElvenettR <|-- RegineSideelv
  RegElvenettR <|-- HovedelvIvassdragsOmr
  ElvenettR <|-- Hovedelv
  ToppRuteP <|-- ElvetoppPunkt
  ElvenettL <|-- ElvBekk
  RegElvenettR <|-- HovedelvIkystfelt
  ElvenettL <|-- ElvelinjeFiktiv
  RegToppRuteP <|-- RegineElvetoppPunkt
  ElvenettL <|-- Innsj_MidtlinjeReg
  ElvenettL <|-- ElvBekkRegulert
  ElvenettL <|-- ElvBekkMidtlinje

@enduml
