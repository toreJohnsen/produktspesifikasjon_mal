@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title FKB-Lufthavn - Filnedlastning - FKB-Lufthavn-5.0.2

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "FKB-Lufthavn-5.0.2" {

  class Taksebanegrense <<featureType>> {
    + grense [1] : GM_Curve
    + eksternpeker [0..1] : URI
  }

  class Lufthavnlys <<featureType>> {
    + posisjon [1] : GM_Point
    + eksternpeker [0..1] : URI
    + lufthavnlystype [1] : Lufthavnlystype
  }

  class Rullebane <<featureType>> {
    + område [1] : GM_Surface
    + posisjon [0..1] : GM_Point
    + eksternpeker [0..1] : URI
  }

  class Helikopterlandingsplass <<featureType>> {
    + område [1] : GM_Surface
    + eksternpeker [0..1] : URI
  }
}

package "Eksterne referanser" <<Frame>> {
  class "KvalitetPåkrevd" as KvalitetP_krevd <<Generelle elementer>> {
  }
}

KvalitetP_krevd <|-- Taksebanegrense
KvalitetP_krevd <|-- Lufthavnlys
KvalitetP_krevd <|-- Rullebane
KvalitetP_krevd <|-- Helikopterlandingsplass

@enduml
